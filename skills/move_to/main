#!/usr/bin/env python3
"""假的移动技能。

调用协议（跟你之前 robot-pick-skill 一样）：
    echo '{"target":"球"}' | ./main move_to

以后蒋丰泽的真底盘接进来，就是把这个文件换掉，
上面的 executor 一行都不用改。
"""
import json
import sys


def main() -> int:
    payload = json.load(sys.stdin)
    target = payload.get("target")

    if not target:
        print(json.dumps({
            "success": False,
            "detail": "缺少参数 target",
            "evidence": {},
        }, ensure_ascii=False))
        return 0

    # 真实实现里这里是：发底盘命令 -> 分段执行 -> 读位姿
    print(json.dumps({
        "success": True,
        "detail": f"已移动到 {target} 附近",
        "evidence": {},
    }, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    sys.exit(main())
