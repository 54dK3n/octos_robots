#!/usr/bin/env python3
"""假的放置技能。"""
import json
import sys


def main() -> int:
    payload = json.load(sys.stdin)
    target = payload.get("target")

    if not target:
        print(json.dumps({
            "success": False,
            "detail": "缺少参数 target",
            "evidence": {},
        }, ensure_ascii=False))
        return 0

    print(json.dumps({
        "success": True,
        "detail": f"已放置到 {target}",
        "evidence": {},
    }, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    sys.exit(main())
